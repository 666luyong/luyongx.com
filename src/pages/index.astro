---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/writing';
import ProjectList from '../components/ProjectList.astro';
const posts = await getPosts();
---
<Base>
  <section class="introduction" aria-labelledby="intro-title">
    <p class="eyebrow">LU YONG · 个人记录</p>
    <h1 id="intro-title">你好，我是 Lu Yong。</h1>
    <p class="intro-role">AI 产品实践者 / 创业探索者</p>
    <div class="intro-copy">
      <p>我负责过 ddnsto、Agentflow 等项目，关注 AI 与真实场景的交汇，喜欢把想法做出来，在实践中寻找答案。</p>
      <p>工作之外，也滑雪、健身，记录生活。这里是我的个人网站，慢慢整理做过的项目、走过的路和想明白的事。</p>
    </div>
    <a class="text-link" href="/about/">更多关于我 <span aria-hidden="true">↗</span></a>
  </section>
  <section class="home-projects" aria-labelledby="projects-title">
    <div class="section-head"><h2 id="projects-title">参与过的项目</h2><a href="/projects/">全部项目 ↗</a></div>
    <ProjectList />
  </section>
  <section class="home-writing" aria-labelledby="writing-title">
    <div class="section-head"><h2 id="writing-title">写下来，留个记录。</h2><a href="/writing/">全部文章 ↗</a></div>
    <p class="section-intro">产品之外，还有生活里的尝试与体会。</p>
    <PostList posts={posts.slice(0, 4)} />
  </section>
</Base>
