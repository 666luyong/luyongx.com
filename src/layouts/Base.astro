---
const { title = 'Lu Yong · AI 产品实践者 / 创业探索者', description = '从真实问题出发，探索 AI 产品、智能组网与 Home Lab。Lu Yong的个人网站与实践记录。' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f5f4ee"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(path, Astro.site)}/><link rel="canonical" href={new URL(path, Astro.site)}/><link rel="icon" href="/favicon.svg"/><title>{title}</title></head><body><a class="skip" href="#main">跳到内容</a><header><a href="/" class="brand" aria-label="Lu Yong的首页">luyong<span>x</span><i>独立思考，动手实践。</i></a><nav aria-label="主导航">{[['/','首页'],['/projects/','Projects'],['/writing/','Writing'],['/about/','About']].map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav></header><main id="main"><slot/></main><footer><a href="/">Lu Yong · luyongx.com</a><span>保持好奇，持续构建。</span><a href="https://github.com/666luyong/luyongx.com">本站源码 ↗</a></footer></body></html>
<style is:global>
:root{font-family:Inter,-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:#262e2a;background:#f5f4ee;font-synthesis:none;--green:#234f43;--muted:#69716a;--line:#d9ddd3}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}a:hover{color:var(--green)}a:focus-visible{outline:2px solid var(--green);outline-offset:6px}header,main,footer{max-width:1160px;margin:auto;padding:0 44px}header{height:112px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:750;font-size:26px;letter-spacing:-1.3px}.brand span{color:#6b8050}.brand i{display:block;font-size:11px;letter-spacing:2px;font-style:normal;font-weight:400;margin-top:6px;color:var(--muted)}nav{display:flex;gap:30px;font-size:13px}nav a[aria-current]{color:var(--green);border-bottom:1px solid;padding-bottom:7px}main{min-height:65vh}footer{border-top:1px solid var(--line);display:flex;justify-content:space-between;padding-top:28px;padding-bottom:34px;font-size:12px;color:var(--muted)}.eyebrow{font-family:monospace;font-size:11px;letter-spacing:2px;color:var(--green);text-transform:uppercase}.hero{display:grid;grid-template-columns:1.6fr 1fr;gap:60px;padding:82px 0 70px;align-items:center}h1{font-size:clamp(38px,5vw,62px);font-weight:550;letter-spacing:-2px;line-height:1.35;margin:24px 0}h1 em{font-family:Georgia,serif;font-style:normal;color:var(--green)}.intro{max-width:550px;font-size:16px;line-height:1.95;color:var(--muted)}.actions{display:flex;gap:24px;align-items:center;margin-top:32px;font-size:13px}.button{background:var(--green);color:#fff;padding:13px 22px;border-radius:3px}.button:hover{background:#326252;color:white}.diagram{background:#e9ede3;aspect-ratio:1;border:1px solid #dce2d3;padding:28px;position:relative;display:flex;flex-direction:column;justify-content:center;gap:18px}.diagram small{position:absolute;top:22px;font-family:monospace;font-size:10px;color:#64745e;letter-spacing:2px}.diagram .node{border:1px solid #a8b6a0;background:#f5f4ee;padding:17px;font-size:13px;display:flex;justify-content:space-between}.diagram .node:nth-child(3){margin-left:30px;background:var(--green);color:white}.diagram .caption{font-size:11px;color:#64745e;margin-top:10px}.section{padding:42px 0 56px;border-top:1px solid var(--line)}.section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:30px}.section-head h2{font-size:23px;font-weight:550;letter-spacing:-.5px;margin:0}.section-head a{font-size:12px;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{display:block;border:1px solid var(--line);padding:25px;transition:transform .2s,background .2s}.card:hover{transform:translateY(-4px);background:#eef0e7}.card .number{font:11px monospace;color:#77826d}.card h3{font-size:21px;font-weight:550;margin:30px 0 14px}.card p{font-size:13px;color:var(--muted);line-height:1.85;margin-bottom:25px}.tag{font-size:10px;color:var(--green);border:1px solid #c7d0bf;padding:5px 8px;display:inline-block}.card .arrow{float:right;color:var(--green)}.note{display:flex;justify-content:space-between;gap:60px;line-height:1.9}.note h2{max-width:300px;font-weight:500;font-size:28px;margin:0}.note p{max-width:530px;color:var(--muted);font-size:14px;margin:0}.page-heading{padding:70px 0 45px}.page-heading h1{font-size:48px;margin:14px 0}.page-heading p{max-width:650px;color:var(--muted);line-height:1.9}.prose{max-width:720px;padding-bottom:75px;line-height:1.95;color:#4f5951}.prose h2{font-size:23px;font-weight:550;color:#262e2a;margin-top:36px}.prose p{margin:15px 0}.prose a{border-bottom:1px solid #879b7a}.back{display:inline-block;font-size:12px;color:var(--muted);margin-top:45px}.article-row{display:grid;grid-template-columns:130px 1fr 30px;border-top:1px solid var(--line);padding:28px 0;gap:20px}.article-row time{font:12px monospace;color:var(--muted);padding-top:5px}.article-row h2{font-weight:550;font-size:22px;margin:0 0 8px}.article-row p{font-size:13px;color:var(--muted);margin:0;line-height:1.8}.skip{position:absolute;left:-999px}.skip:focus{left:20px;top:20px;background:white;padding:15px;z-index:10}@media(max-width:700px){header,main,footer{padding-left:23px;padding-right:23px}header{height:auto;min-height:110px;align-items:flex-start;gap:24px;flex-direction:column;padding-top:22px;padding-bottom:20px}nav{gap:25px}.hero{grid-template-columns:1fr;padding-top:48px;gap:35px}.diagram{max-width:360px;width:100%;aspect-ratio:1.2}.cards{grid-template-columns:1fr}.card h3{margin-top:22px}.note{flex-direction:column;gap:22px}.page-heading{padding-top:45px}.page-heading h1{font-size:38px}.article-row{grid-template-columns:1fr 25px}.article-row time{grid-column:1/-1}footer{flex-wrap:wrap;gap:20px}h1{letter-spacing:-1px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>