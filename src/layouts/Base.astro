---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  mainClass?: string;
}
const {
  title = 'Lu Yong · 产品、实践与生活',
  description = '我是 Lu Yong，AI 产品实践者 / 创业探索者。这里记录 ddnsto、Agentflow 等项目经历，也分享滑雪、健身和日常生活中的思考。',
  article = false, publishedAt, updatedAt, mainClass,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const navigation = [['/', '首页'], ['/projects/', 'Projects'], ['/writing/', 'Writing'], ['/about/', 'About']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Lu Yong 的文章" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">跳到内容</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Lu Yong 的首页">luyong<span>x</span><span class="brand-dot">.</span></a>
      <nav aria-label="主导航">
        {navigation.map(([href, label]) => (
          <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <main id="main" class={mainClass}><slot /></main>
    <footer class="site-footer">
      <div><a href="/">Lu Yong</a><span>产品、实践与生活。</span></div>
      <div><a href="/rss.xml">RSS 订阅</a><a href="https://github.com/666luyong/luyongx.com">本站源码 ↗</a></div>
    </footer>
  </body>
</html>
