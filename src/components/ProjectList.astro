---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';

interface Props { headingLevel?: 'h2' | 'h3'; }
const { headingLevel: Heading = 'h3' } = Astro.props;
---
<div class="project-list">
  {projects.map((project) => (
    <article>
      <a class="project-card" href={project.href} target="_blank" rel="noopener noreferrer">
        <div class="project-card-heading">
          <Heading>{project.name}<span aria-hidden="true">↗</span></Heading>
        </div>
        <p class="project-role">{project.role}</p>
        <Image src={project.image} alt={project.imageAlt}
          width={1440} height={754} widths={[208, 360, 720]}
          sizes="(max-width: 360px) 88px, (max-width: 700px) 104px, (max-width: 1096px) calc((100vw - 136px) / 3 - 34px), 286px"
          loading="lazy" decoding="async" />
        <span class="project-domain">{new URL(project.href).hostname}</span>
        <span class="sr-only">（在新标签页打开官网）</span>
      </a>
    </article>
  ))}
</div>

<style>
  .project-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 28px; }
  .project-card { display: block; height: 100%; padding: 16px; border: 1px solid var(--line); border-radius: 6px; background: var(--card); }
  .project-card:focus-visible { border-color: var(--accent); }
  .project-card:active { background: var(--surface); }
  .project-card-heading h2, .project-card-heading h3 { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 0; color: var(--ink); font-size: 21px; font-weight: 600; letter-spacing: 0; }
  .project-card-heading span { color: var(--accent); font-size: 19px; font-weight: 400; }
  .project-card:focus-visible h2, .project-card:focus-visible h3 { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover { border-color: var(--accent); }
    .project-card:hover h2, .project-card:hover h3 { color: var(--accent); }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-card-heading span { transition: transform 160ms ease-out; }
    .project-card:hover .project-card-heading span { transform: translate(2px, -2px); }
  }
  .project-role { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.7; }
  .project-card img { display: block; width: 100%; height: auto; margin-top: 16px; aspect-ratio: 1440 / 754; border-radius: 4px; outline: 1px solid rgb(0 0 0 / .08); outline-offset: -1px; }
  .project-domain { display: block; margin-top: 12px; color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
  @media (max-width: 700px) {
    .project-list { grid-template-columns: 1fr; gap: 12px; }
    .project-card { display: grid; grid-template-columns: minmax(0, 1fr) 104px; gap: 8px 16px; }
    .project-card-heading { grid-column: 1; grid-row: 1; }
    .project-card-heading h2, .project-card-heading h3 { font-size: 19px; }
    .project-card-heading span { display: none; }
    .project-role { grid-column: 1; grid-row: 2; margin: 0; }
    .project-card img { grid-column: 2; grid-row: 1 / 4; margin: 0; align-self: center; }
    .project-domain { grid-column: 1; grid-row: 3; margin: 0; font-size: 11px; }
  }
  @media (max-width: 360px) {
    .project-card { grid-template-columns: minmax(0, 1fr) 88px; column-gap: 12px; }
  }
</style>
